{
  "name": "lead-to-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "A web form lead to a QuickBooks invoice, with an AI step that can only write ai_ fields and a worker that is tested by killing it.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"test/*.test.ts\"",
    "test:integration": "node --test --test-reporter=spec --test-concurrency=1 \"test/integration/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "sim": "node src/simulators/main.ts",
    "app": "node src/app/server.ts",
    "gen:leads": "node scripts/gen-leads.ts",
    "build:workflow": "node scripts/build-workflow.ts",
    "score": "node scripts/score.ts",
    "setup:hubspot": "node scripts/setup-hubspot.ts",
    "mode": "node scripts/set-mode.ts",
    "e2e:lead-path": "node scripts/e2e-lead-path.ts",
    "scan:repo": "node scripts/scan-repo.ts",
    "export:workflow": "node scripts/export-workflow.ts",
    "worker": "node src/worker/main.ts",
    "connect:quickbooks": "node scripts/connect-quickbooks.ts",
    "test:restart": "node scripts/restart-tests.ts",
    "e2e:invoice-path": "node scripts/e2e-invoice-path.ts",
    "score:injection": "node scripts/score-injection.ts",
    "compare:models": "node scripts/compare-models.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "pg": "^8.23.1"
  }
}
