# Copy to .env. Everything runs on the simulators with no accounts, so the real
# credentials below are only needed for the real run against HubSpot and QuickBooks.
# See docs/real-run.md. .env is git-ignored. Never commit real values.

# Real services are used only when this says real. Anything else uses the simulators,
# even if the credentials below are filled in.
# LTL_TARGET=real

# Classifier for scripts run on this machine, such as scoring. Any OpenAI-compatible
# server works: change these three to use your own model and key.
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=granite-4.1-8b
LLM_API_KEY=lm-studio

# Classifier inside Docker. Unset, the stack uses a scripted stand-in that needs no GPU.
# For a model server on this machine, the host is host.docker.internal, not localhost.
# APP_LLM_BASE_URL=http://host.docker.internal:1234/v1
# APP_LLM_MODEL=granite-4.1-8b
# APP_LLM_API_KEY=lm-studio

# HubSpot service key (Bearer token), for the real run only.
HUBSPOT_TOKEN=

# Intuit app credentials, for the real run only. Sandbox is the only allowed environment.
INTUIT_ENVIRONMENT=sandbox
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
# Must match the app's Redirect URIs setting exactly.
# INTUIT_REDIRECT_URI=http://localhost:8765/callback

# Only if consent has to go through Intuit's OAuth Playground. Delete after connecting.
# INTUIT_REALM_ID=
# INTUIT_REFRESH_TOKEN=

# Encrypts QuickBooks tokens in Postgres. npm run connect:quickbooks generates this.
# LTL_TOKEN_KEY=

# Local database. The default password is for a throwaway local container.
LTL_PG_PASSWORD=
LTL_PG_PORT=5433
